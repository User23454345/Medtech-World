# MedTech World – Umgebungsvariablen der API (apps/api/src/config.ts)
#
# Kopieren nach .env bzw. in der Laufzeitumgebung setzen. Die API liest die Werte aus
# process.env; .env wird NICHT automatisch geladen (z. B. per `node --env-file=.env`,
# Docker `--env-file .env` oder Orchestrierung setzen). Alle Variablen sind optional.
# Relative Pfade beziehen sich auf das Wurzelverzeichnis des Repositorys.

# Betriebsart. "production" aktiviert: Auslieferung des gebauten Frontends, Secure-Cookies,
# HSTS, strukturiertes Logging, trustProxy, Host 0.0.0.0 und deaktiviert Demo-Konten.
NODE_ENV=development

# Netzwerkadresse und Port der API
# Standard: 127.0.0.1 (Entwicklung) bzw. 0.0.0.0 (Produktion)
HOST=127.0.0.1
PORT=3001

# Pfad zur zentralen SQLite-Datenbank (Inhalte + Nutzerdaten)
DATABASE_PATH=.data/medtech-world.db

# Verzeichnis mit den Inhaltsdateien (JSON)
CONTENT_DIR=content

# Inhalte beim Start der API neu aus CONTENT_DIR laden ("false" zum Abschalten).
# Nutzerdaten bleiben beim Seeding immer erhalten. Bei QA-Fehlern startet die API nicht.
SEED_ON_START=true

# Gebautes Frontend, das in Produktion mit ausgeliefert wird (nur bei NODE_ENV=production)
WEB_DIST=apps/web/dist

# Reverse Proxy: X-Forwarded-For nur auswerten, wenn die API hinter einem Proxy läuft.
# Standard: aus (Client-IP = Socket-Adresse). IP/CIDR des Proxys angeben (kommagetrennt,
# z. B. 127.0.0.1 oder 10.0.0.0/8); "true" vertraut jedem Absender und erlaubt das Fälschen
# der IP, sobald die API direkt erreichbar ist (Rate-Limits!).
TRUST_PROXY=

# Sitzungs-Cookie nur über HTTPS senden. Standard: true in Produktion, sonst false.
# Nur in einer reinen HTTP-Testumgebung in Produktion auf "false" setzen.
COOKIE_SECURE=false

# Demo-Konten (lernende@, technik@, redaktion@, admin@medtech.world) anlegen.
# Standard: true in der Entwicklung, false in Produktion – in Produktion werden sie nie angelegt.
SEED_DEMO_USERS=true

# Erstes Administrationskonto – wird nur angelegt, wenn noch kein Konto existiert.
# Passwort nach der ersten Anmeldung ändern und die Variablen danach entfernen.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MedTech Copilot: Mit API-Schlüssel formuliert ein Sprachmodell (Claude) belegte Antworten
# aus der Wissensbasis. Ohne Schlüssel arbeitet der Copilot im Retrieval-Modus
# (passende Inhalte mit Quellen, ohne generierten Text). Niemals einchecken!
ANTHROPIC_API_KEY=
# Modell-ID für den Copilot (Standard: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
